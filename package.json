{
  "name": "borboto",
  "version": "1.0.0",
  "author": {
    "name": "Luis Angel Vallejo Perez",
    "email": "angelvallejop9610@gmail.com",
    "url": "https://portafolio-luisperez.vercel.app/"
  },
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "bunx ng serve --host 127.0.0.1 --open false",
    "build": "ng build",
    "build:server": "esbuild backend-borboto/index.ts --bundle --platform=node --target=node18 --outfile=server.js --external:pg-native",
    "server": "bun run backend-borboto/index.ts",
    "electron:dev": "cross-env NODE_ENV=development concurrently \"bun run start\" \"bun run server\" \"bunx electron .\"",
    "dist": "bun run build && bun run build:server && cross-env NODE_ENV=production electron-builder"
  },
  "build": {
    "appId": "com.borboto.pos",
    "productName": "Borboto POS",
    "copyright": "Copyright © 2026 Luis Angel Vallejo Perez. Todos los derechos reservados.",
    "icon": "BORBOTOIcon.ico",
    "directories": {
      "output": "dist-electron"
    },
    "asarUnpack": [
      "**/node_modules/pdf-to-printer/**/*"
    ],
    "extraFiles": [
      "backend-borboto/.env",
      "licencia_publica.pem",
      "Database/**/*"
    ],
    "extraResources": [
      {
        "from": "backend-borboto/postgres-bin",
        "to": "postgres-bin"
      }
    ],
    "files": [
      "main.js",
      "server.js",
      "license.html",
      "licencia_publica.pem",
      "BORBOTOIcon.ico",
      "dist/**/*",
      "backend-borboto/**/*",
      "package.json"
    ],
    "win": {
      "icon": "BORBOTOIcon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Borboto POS",
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": false
    }
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "cross-env": "^10.1.0"
  },
  "dependencies": {
    "jimp": "^1.6.1"
  }
}