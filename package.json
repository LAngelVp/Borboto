{
  "name": "borboto",
  "version": "1.0.0",
  "author": {
    "name": "Luis Angel Vallejo Perez",
    "email": "angelvallejop9610@gmail.com",
    "url": "https://portafolio-luisperez.vercel.app/"
  },
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "bunx ng serve --host 127.0.0.1 --open false",
    "build": "ng build",
    "build:server": "esbuild backend-borboto/index.ts --bundle --platform=node --target=node18 --outfile=server.js --external:pg-native",
    "server": "bun run backend-borboto/index.ts",
    "electron:dev": "cross-env NODE_ENV=development concurrently \"bun run start\" \"bun run server\" \"bunx electron .\"",
    "dist": "bun run build && bun run build:server && cross-env NODE_ENV=production electron-builder"
  },
  "build": {
    "appId": "com.borboto.pos",
    "productName": "Borboto POS",
    "copyright": "Copyright © 2026 Luis Angel Vallejo Perez. Todos los derechos reservados.",
    "icon": "BORBOTOIcon.ico",
    "directories": {
      "output": "dist-electron"
    },
    "asarUnpack": [
      "**/node_modules/pdf-to-printer/**/*"
    ],
    "extraFiles": [
      "licencia_publica.pem",
      "Database/**/*"
    ],
    "extraResources": [
      {
        "from": "backend-borboto/postgres-bin",
        "to": "postgres-bin"
      }
    ],
    "files": [
      "main.js",
      "server.js",
      "license.html",
      "licencia_publica.pem",
      "BORBOTOIcon.ico",
      "dist/**/*",
      "package.json",
      "!backend-borboto/**/*",
      "!**/.env*"
    ],
    "win": {
      "icon": "BORBOTOIcon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Borboto POS",
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": false
    }
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@angular/animations": "19",
    "@angular/build": "19",
    "@angular/cdk": "19",
    "@angular/cli": "19",
    "@angular/common": "19",
    "@angular/compiler": "19",
    "@angular/compiler-cli": "19",
    "@angular/core": "19",
    "@angular/forms": "19",
    "@angular/material": "19",
    "@angular/platform-browser": "19",
    "@angular/platform-browser-dynamic": "19",
    "@angular/router": "19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "facturapi": "^4.20.0",
    "jimp": "^1.6.1",
    "multer": "^2.0.2",
    "pdf-to-printer": "^5.8.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.1",
    "xlsx": "^0.18.5"
  }
}
